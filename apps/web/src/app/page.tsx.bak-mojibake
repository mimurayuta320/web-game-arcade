  const [shogiChaosBonusTurnColor, setShogiChaosBonusTurnColor] = useState<ShogiColor | null>(null);
  const [selectedShogi, setSelectedShogi] = useState<{ row: number; col: number } | null>(null);
  const shogiMoveTargets = useMemo(() => {
    const targets = new Map<string, { capture: boolean }>();
    if (!selectedShogi) return targets;
    if (shogiMode === "chaos" && shogiChaosFogTurns > 0) return targets;

    const selectedPiece = shogiBoard[selectedShogi.row]?.[selectedShogi.col];
    if (!selectedPiece || selectedPiece.color !== shogiTurn) return targets;

    for (let row = 0; row < 9; row += 1) {
      for (let col = 0; col < 9; col += 1) {
        if (!isLegalShogiMoveWithChaos(shogiBoard, selectedShogi.row, selectedShogi.col, row, col, shogiTurn, shogiMode === "chaos" ? shogiChaosBlockedCell : null, shogiMode === "chaos" && shogiChaosKingAbsorbEnabled)) continue;
        const targetPiece = shogiBoard[row][col];
        targets.set(`${row}-${col}`, {
          capture: Boolean(targetPiece && targetPiece.color !== selectedPiece.color),
        });
      }
    }

    return targets;
  }, [selectedShogi, shogiBoard, shogiTurn, shogiMode, shogiChaosFogTurns, shogiChaosBlockedCell, shogiChaosKingAbsorbEnabled]);
