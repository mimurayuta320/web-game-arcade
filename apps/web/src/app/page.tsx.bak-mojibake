        isBlackjackOver,
        chinchiroPlayerDice,
        chinchiroDealerDice,
        chinchiroBet,
        chinchiroWager,
        chinchiroMessage,
        isChinchiroOver,
        sevensHands,
        sevensTable,
        sevensTurn,
        sevensPassCount,
        sevensMessage,
        isSevensOver,
        daifugoHands,
        daifugoTableCard,
        daifugoTurn,
        daifugoPassStreak,
        daifugoMessage,
        isDaifugoOver,
        fourPanelTitle,
        fourPanelImages,
        fourPanelIndex,
        fourPanelMessage,
        drawingRelayPrompt,
        drawingRelayImage,
        drawingRelayGuess,
        drawingRelayPhase,
        drawingRelayMessage,
        fitPuzzleTiles,
        fitPuzzleMoves,
        fitPuzzleMessage,
